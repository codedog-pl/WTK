{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tests",
            "type": "process",
            "command": "${env:msvc_cl}",
            "options": {
                "env": {
                    "PATH": "${env:PATH};${env:msvc}/bin/Hostx64/x64",  // Ensure link.exe is found
                    "tests": "${workspaceFolder}/Tests",
                    "tests_build": "${workspaceFolder}/Tests/build"
                }
            },
            "args": [
                "/nologo",
                "/Zi",                                // Debug info
                "/FS",                               // Fix PDB lock issues
                "/EHsc",                             // Exception handling
                "/DHAL_HEADER=\"HAL_GPIO_mockup.h\"", // Your macro
                "/DTEST",
                "/std:c++17",
                "/MP",                               // Parallel compilation
                "/W4",                               // Warning level 4
                "/I${env:msvc}/include",
                "/I${env:msvc}/ATLMFC/include",
                "/I${env:msvc_aux}",
                "/I${env:winsdk_headers}/ucrt",
                "/I${env:winsdk_headers}/um",
                "/I${env:winsdk_headers}/shared",
                "/I${env:winsdk_headers}/winrt",
                "/I${env:winsdk_headers}/cppwinrt",
                "/I${env:catch2_include}",
                "/I${workspaceFolder}/Tools",
                "/I${workspaceFolder}/Tools/c",
                "/I${workspaceFolder}/Tests",
                "/I${workspaceFolder}/Tests/Helpers",
                "/Fo${workspaceFolder}/Tests/build/", // Object files
                "/Fd${workspaceFolder}/Tests/build/vc140.pdb", // PDB file
                "${workspaceFolder}/Tests/main.cpp",
                "${workspaceFolder}/Tests/test_libs.cpp",
                "/link",
                "/OUT:${workspaceFolder}/Tests/build/test_runner.exe",
                "/DEBUG",                           // Enable debug linking
                "/LIBPATH:${env:msvc}/ATLMFC/lib/x64",
                "/LIBPATH:${env:msvc}/lib/x64",
                "/LIBPATH:${env:winsdk_libs}/ucrt/x64",
                "/LIBPATH:${env:winsdk_libs}/um/x64",
                "/LIBPATH:${env:catch2_lib}",
                "catch2.lib"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "${workspaceFolder}/Tests/build/test_runner.exe",
            "args": [
                "--durations", "yes",                // Show test durations
                "--rng-seed", "time"                // Randomize test order
            ],
            "dependsOn": ["Build Tests"],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
